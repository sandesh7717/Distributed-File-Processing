# Copy to .env and replace both values before starting.
# Use URL-safe alphanumeric characters for POSTGRES_PASSWORD (it is part of a URL).
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_USER=dfsadmin
MINIO_PASSWORD=replace-with-another-long-random-password
BIND_ADDRESS=127.0.0.1
PORT=8080
MAX_UPLOAD_BYTES=17179869184
# Node server request timeout; raise if a slow large upload needs longer.
UPLOAD_TIMEOUT_MS=3600000
